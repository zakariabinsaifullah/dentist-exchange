{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "dnte/hero-slide",
    "version": "1.0.0",
    "title": "Hero Slide",
    "category": "dnte",
    "icon": "format-image",
    "description": "One slide of a Hero Slider: its own images, and optionally its own content.",
    "parent": ["dnte/hero-slider"],
    "supports": {
        "html": false,
        "reusable": false,
        "color": {
            "text": true,
            "background": false,
            "gradients": false
        }
    },
    "attributes": {
        "id": {
            "type": "number"
        },
        "url": {
            "type": "string"
        },
        "alt": {
            "type": "string",
            "default": ""
        },
        "autoThumb": {
            "type": "string"
        },
        "thumb": {
            "type": "string"
        },
        "thumbId": {
            "type": "number"
        },
        "mobileId": {
            "type": "number"
        },
        "mobileUrl": {
            "type": "string"
        }
    },
    "textdomain": "dentist-exchange",
    "editorScript": ["file:./index.js"],
    "editorStyle": ["file:./index.css"]
}
