{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "dnte/ticker-gallery",
    "version": "0.5.0",
    "title": "Ticker Gallery",
    "category": "dnte",
    "icon": "images-alt",
    "description": "A continuously scrolling row of images, tilted and bottom aligned.",
    "example": {},
    "supports": {
        "anchor": true,
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true,
            "__experimentalDefaultControls": {
                "margin": false,
                "padding": false
            }
        }
    },
    "attributes": {
        "images": {
            "type": "array",
            "default": [],
            "items": {
                "type": "object"
            }
        },
        "blockStyle": {
            "type": "object"
        },
        "tallHeight": {
            "type": "number",
            "default": 304
        },
        "shortRatio": {
            "type": "number",
            "default": 0.88
        },
        "gap": {
            "type": "number",
            "default": 44
        },
        "radius": {
            "type": "number",
            "default": 24
        },
        "speed": {
            "type": "number",
            "default": 40
        },
        "direction": {
            "type": "string",
            "default": "left"
        },
        "pauseOnHover": {
            "type": "boolean",
            "default": true
        }
    },
    "textdomain": "dentist-exchange",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "viewScript": "file:./view.js"
}
