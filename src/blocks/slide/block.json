{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "dnte/slide",
    "version": "0.6.0",
    "title": "Slide",
    "category": "dnte",
    "description": "Slide child block for carousel.",
    "example": {},
    "parent": ["dnte/carousel"],
    "attributes": {
        "stackRotate": {
            "type": "number",
            "default": 0
        },
        "stackOffsetX": {
            "type": "number",
            "default": 0
        },
        "stackOffsetY": {
            "type": "number",
            "default": 0
        },
        "stackZIndex": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "color": {
            "text": false,
            "background": true,
            "gradients": true
        },
        "background": {
            "backgroundImage": true,
            "backgroundSize": true
        },
        "spacing": {
            "margin": false,
            "padding": true,
            "__experimentalDefaultControls": {
                "padding": false
            }
        },
        "__experimentalBorder": {
            "__experimentalSkipSerialization": false,
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "shadow": {
            "__experimentalSkipSerialization": true
        }
    },
    "textdomain": "dentist-exchange",
    "editorScript": ["file:./index.js"],
    "editorStyle": "file:./index.css"
}
