{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "dnte/image-accordion",
    "version": "1.0.0",
    "title": "Image Accordion",
    "category": "dnte",
    "icon": "images-alt2",
    "description": "Display a series of images in an accordion format.",
    "example": {},
    "supports": {
        "anchor": true,
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true,
            "__experimentalDefaultControls": {
                "margin": false,
                "padding": false
            }
        }
    },
    "providesContext": {
        "dnte/showTitle": "showTitle",
        "dnte/showDesc": "showDesc",
        "dnte/showBtn": "showBtn",
        "dnte/titleTag": "titleTag"
    },
    "attributes": {
        "resMode": {
            "type": "string",
            "default": "Desktop"
        },
        "blockStyle": {
            "type": "object"
        },
        "itemsGap": {
            "type": "object",
            "default": {}
        },
        "showTitle": {
            "type": "boolean",
            "default": true
        },
        "showDesc": {
            "type": "boolean",
            "default": true
        },
        "showBtn": {
            "type": "boolean",
            "default": true
        },
        "titleTag": {
            "type": "string",
            "default": "h4"
        }
    },
    "textdomain": "dentist-exchange",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "viewScript": "file:./view.js"
}
