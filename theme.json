    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "link": {
                        "border": {
                            "color": "transparent",
                            "radius": "0px",
                            "style": "none",
                            "width": "0"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--dnte-primary-600)"
                            }
                        },
                        "color": {
                            "background": "transparent",
                            "text": "#487EEC"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    },
                    "alternative": {
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--dnte-primary-400)",
                                "text": "var(--wp--preset--color--dnte-white)"
                            }
                        },
                        "color": {
                            "background": "var(--wp--preset--color--dnte-primary-200)",
                            "text": "var(--wp--preset--color--dnte-primary-950)"
                        }
                    },
                    "outline": {
                        ":hover": {
                            "border": {
                                "color": "#000000"
                            },
                            "color": {
                                "text": "#000000"
                            }
                        },
                        "border": {
                            "color": "var(--wp--preset--color--dnte-primary-800)",
                            "style": "solid",
                            "width": "1px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--dnte-primary-800)"
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
