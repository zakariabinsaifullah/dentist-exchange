                }
            },
            "core/comments-pagination-previous": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/list": {
                "css": "& li{margin-top: 0.5rem;}"
            },
            "core/navigation": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--inter)",
                    "fontSize": "var(--wp--preset--font-size--dnte-paragraph)",
                    "lineHeight": "1.5"
                },
                "color": {
                    "text": "var(--wp--preset--color--dnte-neutral-950)"
                }
            },
            "core/post-comments-form": {
                "css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: var(--wp--preset--color--dnte-neutral-300) !important;} & input[type=checkbox]{margin:0 .2rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--dnte-small); }",
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--dnte-40)",
                        "top": "var(--wp--preset--spacing--dnte-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/post-date": {
                "color": {
                    "text": "var(--wp--preset--color--dnte-neutral-600)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--dnte-neutral-600)"
                        },
                        "typography": {
                            "textDecoration": "none"
