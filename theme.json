            "defaultPresets": false,
            "presets": [
                {
                    "name": "Default Shadow",
                    "shadow": "0 0 11.5px 0 #8FA4B7",
                    "slug": "dnte-shadow"
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "link": {
                        "border": {
                            "color": "transparent",
                            "radius": "0px",
                            "style": "none",
                            "width": "0"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--dnte-wine-berry)"
                            }
                        },
                        "color": {
                            "background": "transparent",
                            "text": "#538988"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    },
                    "alternative": {
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--dnte-white)"
                            }
                        },
                        "border": {
                            "radius": "100px"
                        },
                        "color": {
                            "background": "var(--wp--preset--color--dnte-neptune)",
                            "text": "#000000"
                        }
                    },
                    "outline": {
                        ":hover": {
                            "border": {
                                "color": "#000000"
                            },
                            "color": {
                                "text": "#000000"
                            }
                        },
                        "border": {
                            "color": "var(--wp--preset--color--dnte-white)",
                            "radius": "100px",
                            "style": "solid",
                            "width": "1px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--dnte-white)"
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--dnte-neutral-lightest)",
                    "text": "var(--wp--preset--color--dnte-neutral-darkest)"
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--dnte-40)",
                        "left": "var(--wp--preset--spacing--dnte-40)",
                        "right": "var(--wp--preset--spacing--dnte-40)",
                        "top": "var(--wp--preset--spacing--dnte-40)"
                    }
                },
                "typography": {
                    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)",
                    "fontWeight": "300"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--dnte-50)"
                }
            },
            "core/comment-author-name": {
                "color": {
                    "text": "var(--wp--preset--color--dnte-neutral-dark)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--dnte-neutral-dark)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "spacing": {
                    "margin": {
                        "bottom": "0px",
                        "top": "5px"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-small)"
                }
            },
            "core/comment-content": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--dnte-30)",
                        "top": "var(--wp--preset--spacing--dnte-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/comment-date": {
                "color": {
                    "text": "var(--wp--preset--color--dnte-neutral-darkest)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--dnte-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-small)"
                }
            },
            "core/comment-edit-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--dnte-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-small)"
                }
            },
            "core/comment-reply-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--dnte-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-small)"
                }
            },
            "core/comments-pagination": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--dnte-40)",
                        "top": "var(--wp--preset--spacing--dnte-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/comments-pagination-next": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/comments-pagination-numbers": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/comments-pagination-previous": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/list": {
                "css": "& li{margin-top: 0.5rem;}"
            },
            "core/navigation": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/paragraph": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--freight-text-pro)",
                    "fontSize": "var(--wp--preset--font-size--dnte-large)",
                    "lineHeight": "1.5"
                },
                "color": {
                    "text": "var(--wp--preset--color--dnte-neutral-darker)"
                }
            },
            "core/post-comments-form": {
                "css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: var(--wp--preset--color--dnte-neutral-lighter) !important;} & input[type=checkbox]{margin:0 .2rem 0 0 !important;} & label {font-size: var(--wp--preset--font-size--dnte-small); }",
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--dnte-40)",
                        "top": "var(--wp--preset--spacing--dnte-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-medium)"
                }
            },
            "core/post-date": {
