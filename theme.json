                        "right": "var(--wp--preset--spacing--dnte-40)",
                        "top": "var(--wp--preset--spacing--dnte-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--dnte-large)",
                    "fontWeight": "300"
                },
