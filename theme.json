                },
                {
                    "name": "Soft Shadow",
                    "shadow": "0 4px 20px 0 rgba(123, 123, 123, 0.25)",
                    "slug": "dnte-shadow-soft"
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
